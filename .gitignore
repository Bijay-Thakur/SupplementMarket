# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.screenshots
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_rsa.pub

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env and secrets — NEVER commit real keys, tokens, or filled env files.
# Only committed templates are `.env.example` (and backend/.env.example).
.env
.env.*
!.env.example
!**/.env.example
backend/.env
.envrc
.secrets/
secrets/
credentials.json
*-credentials.json
service-account*.json
google-services.json
**/serviceAccount*.json
.supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python / local demo backend
__pycache__/
*.py[cod]
backend/.venv/
backend/backend/
backend/bnm_demo.db
backend/*.db
backend/storage/products/*
!backend/storage/products/.gitkeep
backend/storage/catalog-imports/*
!backend/storage/catalog-imports/.gitkeep
