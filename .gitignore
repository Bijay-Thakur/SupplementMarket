# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
.screenshots/
test-results/
playwright-report/
.pytest_cache/
.coverage
htmlcov/

# next.js
.next/
/out/
frontend/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
id_rsa.pub

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env and secrets — NEVER commit real keys, tokens, or filled env files.
# Only committed template is the repo-root `.env.example`.
.env
.env.*
!.env.example
.envrc
.secrets/
secrets/
credentials.json
*-credentials.json
service-account*.json
google-services.json
**/serviceAccount*.json
.supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python / local backend runtime
__pycache__/
*.py[cod]
.venv/
*.db
# Legacy local-only runtime data retained after moving the source.
/backend/
frontend/backend/backend/
frontend/backend/storage/products/*
!frontend/backend/storage/products/.gitkeep
frontend/backend/storage/catalog-imports/*
!frontend/backend/storage/catalog-imports/.gitkeep
