# Bronxville Natural Market — backend (local demo) configuration.
# Copy to backend/.env for local development. All values have safe defaults.

# "development" enables demo admin APIs + seed/reset. Set to "production" to
# hard-disable those dev-only surfaces.
ENVIRONMENT=development

# Only this origin is allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000

# SQLite for the local demo (relative to the backend/ directory).
DATABASE_URL=sqlite:///./bnm_demo.db

# Local product-image storage directory (served at /media/products in dev).
STORAGE_DIR=storage/products
CATALOG_IMPORTS_DIR=storage/catalog-imports
MAX_UPLOAD_BYTES=5000000

# Optional contact for the catalog collector User-Agent. Leave blank rather than inventing one.
CATALOG_COLLECTOR_CONTACT_EMAIL=
