# Bronxville Natural Market — single environment file for the whole repo.
# Copy to `.env` (gitignored) and fill in real values.
# NEVER put live secrets in this file. NEVER commit `.env`, `.env.local`,
# `.env.production`, or any file that contains real Supabase or Stripe keys.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_AUTH_ENABLED=true
NEXT_PUBLIC_MOCK_AUTH_ENABLED=false
AUTH_PROVIDER=supabase
NEXT_PUBLIC_DEMO_ROLE_SELECTOR_ENABLED=false
NEXT_PUBLIC_STRIPE_ENABLED=false
PAYMENT_PROVIDER=disabled
DATA_PROVIDER=supabase

APP_ENV=development
FASTAPI_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_URL=

# Browser/server publishable key. Never put a service role or secret key here.
# In the Supabase dashboard also set:
#   Authentication → URL Configuration → Site URL = http://localhost:3000
#   Redirect URLs include http://localhost:3000/auth/callback
# Confirmations stay email-link based (not OTP). Admin access is public.user_roles only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STORE_TIMEZONE=America/New_York

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./bnm_demo.db
STORAGE_DIR=storage/products
CATALOG_IMPORTS_DIR=storage/catalog-imports
MAX_UPLOAD_BYTES=5000000
CATALOG_COLLECTOR_CONTACT_EMAIL=

# Optional Playwright credentials for live auth e2e. Leave blank to skip those tests.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
