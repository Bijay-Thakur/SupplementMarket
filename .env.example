# Bronxville Natural Market — single environment file for the whole repo.
# Copy to `.env` (gitignored) and fill in real values.
# NEVER put live secrets in this file. NEVER commit `.env`, `.env.local`,
# `.env.production`, or any file that contains real Supabase, Stripe, or mock
# signing keys.
#
# Both the Next.js app (`frontend/`) and the FastAPI collector (`backend/`)
# read this file from the repository root.

# ── Feature modes (fail closed on the server) ──────────────────────────────
# Demo (default):
#   AUTH_PROVIDER=mock
#   DATA_PROVIDER=snapshot
#   PAYMENT_PROVIDER=disabled
# Persistent client demo:
#   AUTH_PROVIDER=mock
#   DATA_PROVIDER=supabase
#   PAYMENT_PROVIDER=disabled
# Stripe test:
#   AUTH_PROVIDER=supabase
#   DATA_PROVIDER=supabase
#   PAYMENT_PROVIDER=stripe_test
# Production:
#   AUTH_PROVIDER=supabase
#   DATA_PROVIDER=supabase
#   PAYMENT_PROVIDER=stripe_live

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_AUTH_ENABLED=false
NEXT_PUBLIC_MOCK_AUTH_ENABLED=true
AUTH_PROVIDER=mock
NEXT_PUBLIC_DEMO_ROLE_SELECTOR_ENABLED=true
NEXT_PUBLIC_STRIPE_ENABLED=false
PAYMENT_PROVIDER=disabled
DATA_PROVIDER=snapshot

# FastAPI origin. Leave blank for same-origin Next.js API (required for Vercel).
NEXT_PUBLIC_API_URL=

# Supabase (required when DATA_PROVIDER=supabase or AUTH_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signed mock-session cookie. Required in production if AUTH_PROVIDER=mock.
MOCK_AUTH_SECRET=

# Stripe (required when PAYMENT_PROVIDER is stripe_test or stripe_live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STORE_TIMEZONE=America/New_York

# ── FastAPI collector (optional; local catalog import only) ─────────────────
# "development" enables demo admin APIs + seed/reset. Set to "production" to
# hard-disable those dev-only surfaces.
ENVIRONMENT=development

# Only this origin is allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000

# SQLite for the local collector (relative to the backend/ directory).
DATABASE_URL=sqlite:///./bnm_demo.db

# Local product-image storage directory (served at /media/products in dev).
STORAGE_DIR=storage/products
CATALOG_IMPORTS_DIR=storage/catalog-imports
MAX_UPLOAD_BYTES=5000000

# Optional contact for the catalog collector User-Agent. Leave blank rather than inventing one.
CATALOG_COLLECTOR_CONTACT_EMAIL=
