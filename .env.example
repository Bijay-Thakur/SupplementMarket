# Bronxville Natural Market — environment variables
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Variables are optional in development; features degrade gracefully and the
# app logs a clear "not configured" state instead of exposing partial secrets.

# ── Public (safe to expose to the browser) ─────────────────────────────────
# Fully-qualified site URL used for canonical/OG metadata and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Master switch for customer-facing auth. Keep false until launch is approved.
NEXT_PUBLIC_CUSTOMER_AUTH_ENABLED=false
# Development-only role chooser (customer vs admin). NOT authentication.
# Must be false (and the UI removed) before production.
NEXT_PUBLIC_DEMO_ROLE_SELECTOR_ENABLED=true
# FastAPI origin. Leave blank for same-origin Next.js API (required for Vercel).
# Set USE_FASTAPI=1 in next.config only when running the local Python collector.
NEXT_PUBLIC_API_URL=
# Supabase project URL and anon key (public, RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Stripe publishable key (test key begins with pk_test_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Server only (NEVER prefix these with NEXT_PUBLIC_) ─────────────────────
# Supabase service-role key. Bypasses RLS. Server code only.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe secret key (test key begins with sk_test_).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...). Used to verify webhook payloads.
STRIPE_WEBHOOK_SECRET=
# IANA timezone used for promotion scheduling and store-hour display.
STORE_TIMEZONE=America/New_York
