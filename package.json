{
  "name": "bronxville-natural-market",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "node scripts/run-python.mjs -m uvicorn app.main:app --reload --port 8000",
    "dev:backend": "npm run dev:api",
    "dev:all": "concurrently -n web,api -c magenta,green \"npm run dev:web\" \"npm run dev:api\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "test": "npm run test -w frontend",
    "test:watch": "npm run test:watch -w frontend",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:api": "node scripts/run-python.mjs -m pytest",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:api",
    "seed:demo": "node scripts/run-python.mjs -m app.seed.run",
    "migrate": "node scripts/run-python.mjs -m alembic upgrade head",
    "catalog:collect": "node scripts/run-python.mjs -m app.catalog.cli collect-all --per-brand 6",
    "catalog:collect:dry": "node scripts/run-python.mjs -m app.catalog.cli collect-all --per-brand 6 --dry-run --skip-images",
    "catalog:validate": "node scripts/run-python.mjs -m app.catalog.cli validate",
    "catalog:test": "node scripts/run-python.mjs -m pytest tests/test_catalog_ingestion.py tests/test_catalog_adapters.py tests/test_catalog_http.py tests/test_catalog_workflow.py",
    "catalog:export": "node scripts/run-python.mjs -m app.catalog.export_snapshot",
    "catalog:import-supabase": "node scripts/import-catalog-to-supabase.mjs",
    "logo:optimize": "npm run logo:optimize -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "supabase": "^2.116.0"
  }
}
